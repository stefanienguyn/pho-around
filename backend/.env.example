# Copy to .env (gitignored) and fill in the real values. In a deployment these
# same names are set in the hosting platform's environment dashboard instead —
# the code only ever names the drawer, never its contents.

# Backend key — a true server-side secret (server-to-server calls carry no
# referrer, so restrictions can't protect it). Restricted to Geocoding API,
# Routes API and Places API.
GOOGLE_MAPS_API_KEY=your-backend-maps-key-here

# Extra browser origins allowed to call this API cross-origin, comma-separated.
# The Vite dev origins are always allowed; set this to the deployed frontend's
# origin, e.g. https://pho-around.vercel.app
ALLOWED_ORIGINS=

# Optional: how many seconds CBC may search per request (default 10). Lower it
# on small instances to answer sooner with a slightly less polished plan.
SOLVER_TIME_LIMIT_S=10

# Optional: buy live, traffic-aware times for the start->place legs (default
# false). This is the ONLY per-user-action Google cost: ~25 Compute Route
# Matrix elements a click, ~$0.33 at Aug-2026 rates. Off means the start leg
# uses the calibrated haversine estimate instead (median 1.7 min error against
# the 1,988 real legs in the matrix). Place-to-place times are always free —
# they come from the committed matrix either way.
USE_LIVE_START_LEGS=false
