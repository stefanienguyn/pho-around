# Copy to .env.local (gitignored) and fill in the real value.
# Frontend Maps key — visible in the browser by design; its protection is the
# key's own restrictions (HTTP referrer + Maps JavaScript API only), so the
# referrer list must include every origin the app is served from.
VITE_GOOGLE_MAPS_API_KEY=your-frontend-maps-key-here

# Backend base URL. Optional locally (defaults to http://127.0.0.1:8000);
# set in the hosting platform's environment for deployments. Baked in at
# build time, so changing it requires a rebuild.
VITE_API_URL=http://127.0.0.1:8000
